# Copie ce fichier en ".env" et adapte les adresses.
# .env n'est jamais envoyé sur GitHub (il est dans .gitignore).

# Adresse de PocketBase utilisée AU BUILD (lecture des projets)
# - en local : http://127.0.0.1:8090
# - en production : l'adresse de PocketBase sur le VPS
POCKETBASE_URL=http://127.0.0.1:8090

# Adresse PUBLIQUE de PocketBase, utilisée par le NAVIGATEUR
# (envoi du formulaire de contact). Le préfixe PUBLIC_ la rend visible
# dans le JavaScript du site : ne jamais y mettre de secret.
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
