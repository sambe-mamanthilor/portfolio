---
import ProjectCard from './ProjectCard.astro';
import portfolioData from '../data/portfolio.json';
---

<section
  id="projects"
  class="relative overflow-hidden py-32 bg-[#020617]"
>
<div
  class="absolute inset-0 opacity-[0.45]"
  style="
    background-image:url('/images/code-bg.jpg');
    background-size:cover;
    background-position:center;
  "
></div>

  <!-- Grille -->

  <div
    class="absolute inset-0 opacity-20"
    style="
      background-image:
      linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
      background-size:40px 40px;
    "
  ></div>

  <!-- Halo -->

  <div class="absolute top-20 left-20 w-[400px] h-[400px] bg-cyan-500/20 rounded-full blur-[150px]"></div>

  <div class="absolute bottom-20 right-20 w-[300px] h-[300px] bg-sky-500/20 rounded-full blur-[120px]"></div>

  <div class="container-custom relative z-10">

    <div class="max-w-4xl mb-20">


      <h2
        class="text-4xl lg:text-7xl font-bold text-white mt-4 mb-8"
        style="font-family:'Playfair Display', serif;"
      >
        Mes projets
      </h2>

      <p class="text-xl text-slate-300 leading-relaxed">
        Des projets réalisés dans le cadre de ma formation,
        de projets personnels et de mises en situation
        professionnelles mêlant développement web,
        UX/UI, gestion de projet et communication digitale.
      </p>

    </div>

    <!-- CIELIXIR -->

    <a
  href="/projects/cielixir"
  class="group block mb-12 max-w-5xl mx-auto"
>
      <div
        class="
          rounded-[40px]
          overflow-hidden
          border
          border-cyan-500/20
          bg-slate-900/80
          backdrop-blur-xl
          transition-all
          duration-500
          hover:border-cyan-400/50
          hover:-translate-y-1
        "
      >

        <div class="grid lg:grid-cols-2">

          <div class="overflow-hidden">

            <img
              src="/images/cielixir.png"
              alt="Cielixir"
              class="
                w-full
                h-full
                object-cover
                transition
                duration-700
                group-hover:scale-105
              "
            />

          </div>

          <div class="p-10 lg:p-14 flex flex-col justify-center">

            <span
              class="
                inline-flex
                w-fit
                px-4
                py-2
                rounded-full
                bg-cyan-500/10
                text-cyan-300
                text-sm
                font-semibold
                mb-6
              "
            >
              Projet phare
            </span>

            <h3 class="text-5xl font-bold text-white mb-6">
              Cielixir
            </h3>

            <p class="text-slate-300 leading-relaxed mb-8 text-lg">
              Plateforme digitale qui recommande une boisson
              adaptée à la météo, aux envies et au profil utilisateur.
              Projet collectif réalisé en tant que cheffe de projet,
              développeuse et conceptrice UX/UI.
            </p>

            <div class="flex flex-wrap gap-3 mb-8">

              <span class="px-4 py-2 rounded-full bg-slate-800 text-cyan-300">
                Cheffe de projet
              </span>

              <span class="px-4 py-2 rounded-full bg-slate-800 text-cyan-300">
                Astro
              </span>

              <span class="px-4 py-2 rounded-full bg-slate-800 text-cyan-300">
                Tailwind
              </span>

              <span class="px-4 py-2 rounded-full bg-slate-800 text-cyan-300">
                PocketBase
              </span>

              <span class="px-4 py-2 rounded-full bg-slate-800 text-cyan-300">
                API météo
              </span>

            </div>

            <span class="text-cyan-400 font-semibold text-lg">
              Découvrir le projet →
            </span>

          </div>

        </div>

      </div>

    </a>

    <!-- AUTRES PROJETS -->

<div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6">

  <!-- Alice -->

  <a
    href="/projects/alice-recoque"
    class="
      group
      rounded-3xl
      overflow-hidden
      border
      border-cyan-500/20
      bg-slate-900/80
      backdrop-blur-xl
      hover:border-cyan-400/50
      transition-all
      duration-300
      hover:-translate-y-2
    "
  >

    <div class="h-40 overflow-hidden">

      <img
        src="/images/effet-matilda.png"
        alt="Alice Recoque"
        class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
      />

    </div>

    <div class="p-5">

      <h3 class="text-xl font-bold text-white mb-2">
        Alice Recoque
      </h3>

      <p class="text-slate-400 text-sm mb-4 line-clamp-2">
        Site web mobile-first consacré à une pionnière de l'informatique.
      </p>

      <div class="flex flex-wrap gap-2 mb-5">

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          HTML
        </span>

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          CSS
        </span>

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          JavaScript
        </span>

      </div>

      <span class="text-cyan-400 font-semibold text-sm">
        Découvrir →
      </span>

    </div>

  </a>

  <!-- Olyvia -->

  <a
    href="/projects/olyvia"
    class="
      group
      rounded-3xl
      overflow-hidden
      border
      border-cyan-500/20
      bg-slate-900/80
      backdrop-blur-xl
      hover:border-cyan-400/50
      transition-all
      duration-300
      hover:-translate-y-2
    "
  >

    <div class="h-40 overflow-hidden">

      <img
        src="/images/olyvia.png"
        alt="Olyvia"
        class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
      />

    </div>

    <div class="p-5">

      <h3 class="text-xl font-bold text-white mb-2">
        Olyvia
      </h3>

      <p class="text-slate-400 text-sm mb-4 line-clamp-2">
        Recherche utilisateur et conception d'une plateforme dédiée à la ménopause.
      </p>

      <div class="flex flex-wrap gap-2 mb-5">

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          Wordpress
        </span>

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          Figma
        </span>
         <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          Plugins
        </span>

        
      </div>

      <span class="text-cyan-400 font-semibold text-sm">
        Découvrir →
      </span>

    </div>

  </a>

  <!-- Festival -->

  <a
    href="/projects/festival-musique"
    class="
      group
      rounded-3xl
      overflow-hidden
      border
      border-cyan-500/20
      bg-slate-900/80
      backdrop-blur-xl
      hover:border-cyan-400/50
      transition-all
      duration-300
      hover:-translate-y-2
    "
  >

    <div class="h-40 overflow-hidden">

      <img
        src="/images/festival.png"
        alt="Festival"
        class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
      />

    </div>

    <div class="p-5">

      <h3 class="text-xl font-bold text-white mb-2">
        Festival de musique
      </h3>

      <p class="text-slate-400 text-sm mb-4 line-clamp-2">
        Site web responsive avec templates dynamiques et filtres interactifs.
      </p>

      <div class="flex flex-wrap gap-2 mb-5">

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          HTML
        </span>

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          CSS
        </span>

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          JavaScript
        </span>

      </div>

      <span class="text-cyan-400 font-semibold text-sm">
        Découvrir →
      </span>

    </div>

  </a>

  <!-- elm design -->

  <a
    href="/projects/elm-design"
    class="
      group
      rounded-3xl
      overflow-hidden
      border
      border-cyan-500/20
      bg-slate-900/80
      backdrop-blur-xl
      hover:border-cyan-400/50
      transition-all
      duration-300
      hover:-translate-y-2
    "
  >

    <div class="h-40 overflow-hidden">

      <img
        src="/images/elm-design.png"
        alt="Micro-trottoir"
        class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
      />

    </div>

    <div class="p-5">

      <h3 class="text-xl font-bold text-white mb-2">
        Création d'entreprise
      </h3>

      <p class="text-slate-400 text-sm mb-4 line-clamp-2">
        Mise en place complète d'une entrerprise de design et communication digitale : identité visuelle, étude de marché, budgétisation, et stratégie de communication.
      </p>

      <div class="flex flex-wrap gap-2 mb-5">

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
          Communication digitale
        </span>

        <span class="text-xs px-2 py-1 rounded-full bg-cyan-500/10 text-cyan-300">
        étude de marché</span>

      </div>

      <span class="text-cyan-400 font-semibold text-sm">
        Découvrir →
      </span>

    </div>

  </a>

</div>

  </div>

</section>