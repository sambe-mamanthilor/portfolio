---
/**
 * Header : navigation principale, avec DEUX états.
 *
 *  - "Sur la couverture" (accueil, en haut de page) : menu discret, sans
 *    fond, liens en texte blanc, page active soulignée en cyan.
 *  - "Pilule" (partout ailleurs, et dès qu'on a dépassé la couverture) :
 *    la barre arrondie bleu nuit avec le halo cyan.
 *
 * Comment ça marche : la couverture porte l'attribut data-couverture.
 * Un IntersectionObserver (API du navigateur, plus léger qu'un écouteur
 * "scroll") nous prévient quand elle sort de l'écran ; on bascule alors
 * l'attribut data-sur-couverture du header. Tout le visuel est en CSS.
 * Sans JavaScript : la pilule s'affiche toujours (rien n'est perdu).
 *
 * Accessibilité :
 *  - <nav aria-label> : les lecteurs d'écran annoncent "Navigation principale" ;
 *  - aria-current="page" : indique la page sur laquelle on se trouve ;
 *  - le bouton du menu mobile annonce son état (aria-expanded)
 *    et se referme avec la touche Échap.
 */
import Logo from './Logo.astro';
import { NAVIGATION, SITE } from '../data/site';

// Chemin actuel sans "/" final, pour comparer avec les liens
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const estActif = (href: string) =>
  href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(`${href}/`);
---

<header class="entete sticky top-0 z-40 bg-transparent px-4 pt-4" data-theme="mts-nuit" data-entete>
  <nav
    aria-label="Navigation principale"
    class="nav-pilule relative mx-auto flex items-center justify-between gap-4 rounded-full px-3 py-2 md:px-5"
    data-nav
  >
    <a href="/" class="rounded-full" aria-label={`Accueil – ${SITE.nom}`}>
      <Logo taille={46} />
    </a>

    <!-- Bouton du menu : visible uniquement sur mobile (md:hidden) -->
    <button
      type="button"
      class="grid size-11 place-items-center rounded-full text-base-content md:hidden"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-bouton
    >
      <span class="sr-only" data-menu-libelle>Ouvrir le menu</span>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <ul
      id="menu-principal"
      class="menu-liste absolute inset-x-0 top-[calc(100%+0.5rem)] hidden flex-col gap-1 rounded-box p-3 md:static md:flex md:flex-row md:items-center md:gap-2 md:p-0"
    >
      {NAVIGATION.map((lien) => (
        <li>
          <a
            href={lien.href}
            class="lien-nav block rounded-full px-4 py-2 font-bold"
            aria-current={estActif(lien.href) ? 'page' : undefined}
          >
            {lien.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* ---------- État "pilule" (par défaut) ---------- */
  .nav-pilule {
    max-width: 64rem;
    background: rgb(10 15 46 / 0.94);
    /* Halo cyan fin sous la barre + ombre douce pour se détacher des sections claires */
    box-shadow: 0 3px 0 #35c3ea, 0 10px 30px rgb(10 15 46 / 0.18);
    backdrop-filter: blur(8px);
    transition: max-width 0.4s ease, background-color 0.4s ease, box-shadow 0.4s ease;
  }

  .lien-nav {
    position: relative;
    color: var(--color-base-content);
    transition: color 0.2s, background-color 0.2s, opacity 0.2s;
  }
  .lien-nav:hover {
    color: var(--color-primary);
  }
  /* Page active : fond cyan clair, texte bleu nuit */
  .lien-nav[aria-current='page'] {
    background: var(--color-primary);
    color: var(--color-primary-content);
  }

  /* ---------- État "sur la couverture" (accueil, en haut de page) ---------- */
  [data-sur-couverture] .nav-pilule {
    max-width: 80rem; /* même largeur que le contenu de la couverture */
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }
  /* Sur mobile, le menu ouvert garde son fond : on ne touche qu'à l'écran large */
  @media (min-width: 768px) {
    [data-sur-couverture] .lien-nav {
      font-weight: 600;
      opacity: 0.85;
    }
    [data-sur-couverture] .lien-nav:hover {
      color: var(--color-base-content);
      opacity: 1;
    }
    /* Soulignement cyan : court pour la page active, pleine largeur au survol */
    [data-sur-couverture] .lien-nav::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: 0.15rem;
      width: 0;
      height: 2px;
      border-radius: 2px;
      background: var(--color-primary);
      transform: translateX(-50%);
      transition: width 0.25s ease;
    }
    [data-sur-couverture] .lien-nav:hover::after {
      width: calc(100% - 2rem);
    }
    [data-sur-couverture] .lien-nav[aria-current='page'] {
      background: transparent;
      color: var(--color-base-content);
      opacity: 1;
    }
    [data-sur-couverture] .lien-nav[aria-current='page']::after {
      width: 1.5rem;
    }
  }

  /* ---------- Menu mobile ouvert ---------- */
  [data-ouvert] .menu-liste {
    display: flex;
    background: var(--color-base-100);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.4);
  }
</style>

<script>
  const entete = document.querySelector<HTMLElement>('[data-entete]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const bouton = document.querySelector<HTMLButtonElement>('[data-menu-bouton]');
  const libelle = document.querySelector<HTMLElement>('[data-menu-libelle]');

  // 1. Menu discret tant que la couverture est visible (accueil uniquement)
  const couverture = document.querySelector('[data-couverture]');
  if (entete && couverture) {
    entete.setAttribute('data-sur-couverture', '');
    // rootMargin négatif : la bascule se fait quand le bas de la couverture
    // passe sous le menu (96 px depuis le haut de l'écran).
    const observateur = new IntersectionObserver(
      ([entree]) => entete.toggleAttribute('data-sur-couverture', entree.isIntersecting),
      { rootMargin: '-96px 0px 0px 0px', threshold: 0 },
    );
    observateur.observe(couverture);
  }

  // 2. Ouverture / fermeture du menu mobile
  function basculer(ouvrir: boolean) {
    if (!nav || !bouton || !libelle) return;
    nav.toggleAttribute('data-ouvert', ouvrir);
    bouton.setAttribute('aria-expanded', String(ouvrir));
    libelle.textContent = ouvrir ? 'Fermer le menu' : 'Ouvrir le menu';
  }

  bouton?.addEventListener('click', () => {
    basculer(bouton.getAttribute('aria-expanded') !== 'true');
  });

  // Échap referme le menu et rend le focus au bouton
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.hasAttribute('data-ouvert')) {
      basculer(false);
      bouton?.focus();
    }
  });
</script>
