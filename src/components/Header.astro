---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-[9999]">
  <div class="px-4 pt-4">

    <nav
      class="
        container-custom
        mx-auto
        flex
        items-center
        justify-between
        rounded-full
        border
        border-cyan-400/20
        bg-slate-950/75
        backdrop-blur-xl
        shadow-2xl
        px-6
        py-4
      "
  >

    <!-- Logo -->

    <a href="/" class="flex items-center gap-4 group">

      <div
        class="
          w-12
          h-12
          rounded-full
          bg-gradient-to-br
          from-cyan-400
          to-sky-600
          flex
          items-center
          justify-center
          shadow-lg
          shadow-cyan-500/30
          transition
          duration-300
          group-hover:scale-110
        "
      >
        <span class="text-white font-bold tracking-wider">
          MTS
        </span>
      </div>

     

    </a>

    <!-- Desktop -->

    <ul class="hidden lg:flex items-center gap-10">

      <li>
        <a
          href="/#hero"
          class="
            relative
            text-slate-200
            font-medium
            transition
            hover:text-cyan-300
            after:absolute
            after:left-0
            after:-bottom-2
            after:w-0
            after:h-[2px]
            after:bg-cyan-400
            after:transition-all
            hover:after:w-full
          "
        >
          Accueil
        </a>
      </li>

      <li>
        <a
          href="/#about"
          class="
            relative
            text-slate-200
            font-medium
            transition
            hover:text-cyan-300
            after:absolute
            after:left-0
            after:-bottom-2
            after:w-0
            after:h-[2px]
            after:bg-cyan-400
            after:transition-all
            hover:after:w-full
          "
        >
          À propos
        </a>
      </li>

      <li>
        <a
          href="/#competences"
          class="
            relative
            text-slate-200
            font-medium
            transition
            hover:text-cyan-300
            after:absolute
            after:left-0
            after:-bottom-2
            after:w-0
            after:h-[2px]
            after:bg-cyan-400
            after:transition-all
            hover:after:w-full
          "
        >
          Compétences
        </a>
      </li>

      <li>
        <a
          href="/#projects"
          class="
            relative
            text-slate-200
            font-medium
            transition
            hover:text-cyan-300
            after:absolute
            after:left-0
            after:-bottom-2
            after:w-0
            after:h-[2px]
            after:bg-cyan-400
            after:transition-all
            hover:after:w-full
          "
        >
          Projets
        </a>
      </li>

      <li>
        <a
          href="/#formation"
          class="
            relative
            text-slate-200
            font-medium
            transition
            hover:text-cyan-300
            after:absolute
            after:left-0
            after:-bottom-2
            after:w-0
            after:h-[2px]
            after:bg-cyan-400
            after:transition-all
            hover:after:w-full
          "
        >
          Parcours
        </a>
      </li>

      <li>
        <a
          href="/#experiences"
          class="
            relative
            text-slate-200
            font-medium
            transition
            hover:text-cyan-300
            after:absolute
            after:left-0
            after:-bottom-2
            after:w-0
            after:h-[2px]
            after:bg-cyan-400
            after:transition-all
            hover:after:w-full
          "
        >
          Expériences
        </a>
      </li>

      <li>

        <a
          href="/contact"
          class="
            px-7
            py-3
            rounded-full
            bg-gradient-to-r
            from-cyan-500
            to-sky-600
            text-white
            font-semibold
            shadow-lg
            hover:shadow-cyan-500/40
            hover:scale-105
            transition-all
            duration-300
          "
        >
          Contact
        </a>

      </li>

    </ul>

    <!-- Bouton mobile -->

    <button
      id="mobile-menu-btn"
      class="
        lg:hidden
        w-12
        h-12
        rounded-full
        border
        border-cyan-400/20
        bg-slate-900/70
        text-white
        flex
        items-center
        justify-center
      "
    >

      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>

    </button>
        <!-- Mobile Menu -->

    <div
      id="mobile-menu"
      class="
        hidden
        absolute
        top-24
        left-4
        right-4
        rounded-3xl
        border
        border-cyan-400/20
        bg-slate-950/95
        backdrop-blur-xl
        shadow-2xl
        overflow-hidden
      "
    >

      <ul class="flex flex-col py-6">

        <li>
          <a href="/#hero" class="block px-8 py-4 text-slate-200 hover:text-cyan-300 hover:bg-cyan-500/10 transition">
            Accueil
          </a>
        </li>

        <li>
          <a href="/#about" class="block px-8 py-4 text-slate-200 hover:text-cyan-300 hover:bg-cyan-500/10 transition">
            À propos
          </a>
        </li>

        <li>
          <a href="/#competences" class="block px-8 py-4 text-slate-200 hover:text-cyan-300 hover:bg-cyan-500/10 transition">
            Compétences
          </a>
        </li>

        <li>
          <a href="/#projects" class="block px-8 py-4 text-slate-200 hover:text-cyan-300 hover:bg-cyan-500/10 transition">
            Projets
          </a>
        </li>

        <li>
          <a href="/#formation" class="block px-8 py-4 text-slate-200 hover:text-cyan-300 hover:bg-cyan-500/10 transition">
            Parcours
          </a>
        </li>

        <li>
          <a href="/#experiences" class="block px-8 py-4 text-slate-200 hover:text-cyan-300 hover:bg-cyan-500/10 transition">
            Expériences
          </a>
        </li>

        <li>
          <a href="/#passions" class="block px-8 py-4 text-slate-200 hover:text-cyan-300 hover:bg-cyan-500/10 transition">
            Passions
          </a>
        </li>

        <li class="px-8 pt-6">

          <a
            href="/contact"
            class="
              flex
              justify-center
              rounded-full
              bg-gradient-to-r
              from-cyan-500
              to-sky-600
              py-4
              text-white
              font-semibold
              shadow-lg
              hover:scale-105
              transition
            "
          >
            Me contacter
          </a>

        </li>

      </ul>

    </div>

  </nav>

</header>

<script>

const btn = document.getElementById("mobile-menu-btn");
const menu = document.getElementById("mobile-menu");

btn?.addEventListener("click", () => {
  menu?.classList.toggle("hidden");
});

window.addEventListener("scroll", () => {

  const header = document.querySelector("header");

  if(window.scrollY > 20){

    header?.classList.add("py-3");

    header?.classList.remove("py-5");

  }else{

    header?.classList.remove("py-3");

    header?.classList.add("py-5");

  }

});

</script>

<style>

header{

  transition:.35s ease;

}

nav{

  transition:.35s ease;

}

</style>