---
/**
 * Un outil / une technologie : icône + nom.
 * L'icône est décorative (alt="") car le nom est déjà écrit à côté :
 * sinon un lecteur d'écran lirait "Astro Astro".
 */
import { fileUrl, type Outil } from '../lib/pocketbase';
import { ICONES_OUTILS } from '../lib/medias';

interface Props {
  outil: Outil;
  /** "sombre" (défaut) suit le thème de la zone ; "clair" force un fond blanc. */
  variante?: 'clair' | 'sombre';
}
const { outil, variante = 'sombre' } = Astro.props;
// Icône déposée dans PocketBase en priorité, sinon celle de src/assets/images/outils
// (".src" = l'adresse de l'image une fois le site construit).
const icone = fileUrl(outil, outil.icone) ?? ICONES_OUTILS[outil.slug]?.src;
---

<span class:list={['badge-outil inline-flex items-center gap-2 rounded-field px-3 py-1.5 text-sm font-semibold', variante]}>
  {icone && <img src={icone} alt="" width="20" height="20" loading="lazy" class="size-5 object-contain" />}
  {outil.nom}
</span>

<style>
  .sombre {
    background: var(--color-base-200);
    border: 1px solid var(--color-base-300);
    color: var(--color-base-content);
  }
  .clair {
    background: rgb(255 255 255 / 0.75);
    border: 1px solid rgb(10 15 46 / 0.15);
    color: #0a0f2e;
  }
</style>
