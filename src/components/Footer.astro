---
/**
 * Footer : vague, logo, nom, navigation et réseaux.
 * Même disposition qu'avant, en un peu plus compact.
 *
 * La forme de vague vient de la classe "vague", définie une seule fois
 * dans global.css (c'est un masque CSS, impossible à écrire en classes Tailwind).
 */
import Logo from './Logo.astro';
import { SITE } from '../data/site';

const annee = new Date().getFullYear();

const liens = [
  { texte: 'À propos', href: '/a-propos' },
  { texte: 'Projets', href: '/projets' },
  { texte: 'Expériences', href: '/a-propos#experiences' },
  { texte: 'Contact', href: '/contact' },
  { texte: 'Mentions légales', href: '/mentions-legales' },
];
---

<footer
  data-theme="mts-nuit"
  class="vague mt-auto bg-linear-to-b from-[#3d5a6c] via-[#1b2a4a] via-40% to-[#0a0f2e] pb-6 text-base-content"
>
  <!-- Identité -->
  <div class="container-site flex flex-col items-center pt-4 text-center">
    <Logo taille={52} />
    <p class="mt-3 font-display text-2xl md:text-3xl">
      {SITE.prenom} <span class="text-primary">{SITE.nomFamille}</span>
    </p>
    <p class="mt-1 font-semibold text-primary md:text-lg">{SITE.accroche}</p>
  </div>

  <hr class="container-site my-6 border-secondary/40" />

  <div class="container-site grid gap-8 md:grid-cols-2 md:items-start">
    <!-- Navigation -->
    <nav aria-label="Navigation du pied de page" class="md:justify-self-center">
      <h2 class="text-lg font-semibold text-muted">Navigation</h2>
      <ul class="mt-2 space-y-1.5 text-muted">
        {liens.map((lien) => (
          <li><a href={lien.href} class="hover:text-primary">{lien.texte}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Réseaux + contact -->
    <div class="flex flex-col items-center gap-3 md:justify-self-center">
      <ul class="flex gap-2 rounded-box border border-base-300 bg-base-200 p-3" aria-label="Mes réseaux">
        <li>
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-0.5 rounded-field px-3 py-1 hover:text-primary"
          >
            <svg class="text-[#35c3ea]" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            <span class="text-sm font-medium">LinkedIn</span>
            <span class="text-xs opacity-80">Voir mon profil</span>
            <span class="sr-only">(nouvel onglet)</span>
          </a>
        </li>
        <li>
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-0.5 rounded-field px-3 py-1 hover:text-primary"
          >
            <svg class="text-[#35c3ea]" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3"/></svg>
            <span class="text-sm font-medium">GitHub</span>
            <span class="text-xs opacity-80">Consulter</span>
            <span class="sr-only">(nouvel onglet)</span>
          </a>
        </li>
      </ul>
      <a href="/contact" class="btn btn-secondary btn-sm px-8">Me contacter</a>
    </div>
  </div>

  <hr class="container-site my-6 border-secondary/40" />

  <!-- Bas de page -->
  <div class="container-site flex flex-col gap-1 text-center text-sm text-muted md:flex-row md:justify-between md:text-left">
    <p>© {annee} {SITE.nom} — Tous droits réservés.</p>
    <p>Conçu avec Astro, Tailwind CSS et PocketBase</p>
  </div>
</footer>
