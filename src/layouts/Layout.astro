---
// Layout : la structure HTML commune à TOUTES les pages.
// Chaque page l'utilise comme ceci :
//   <Layout title="Projets" description="...">contenu</Layout>
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Titre propre à la page, ex. "Projets". Le nom du site est ajouté automatiquement. */
  title?: string;
  /** Résumé de la page (150-160 caractères) : c'est le texte affiché par Google. */
  description?: string;
  /** Image de partage (LinkedIn, Slack...), chemin depuis /public. */
  image?: string;
}

const SITE_NAME = 'Maman Thilor SAMBE';

const {
  title,
  description = "Portfolio de Maman Thilor SAMBE, étudiante en BUT MMI : développement web front-end et full-stack, intégration et UX/UI design. En recherche d'alternance et de stage.",
  image = '/images/og-image.jpg',
} = Astro.props;

// "Projets | Maman Thilor SAMBE" sur les pages internes, le nom seul sur l'accueil.
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}, développeuse web`;

// URL absolue de la page courante (utilise `site` défini dans astro.config.mjs).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr" data-theme="mts">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph : aperçu quand le lien est partagé sur LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />

    <!-- Couleur de la barre du navigateur sur mobile -->
    <meta name="theme-color" content="#010f2a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- Lien d'évitement : premier élément atteint avec Tab.
         Il permet aux personnes qui naviguent au clavier ou avec un lecteur
         d'écran de sauter directement au contenu. Invisible tant qu'il
         n'a pas le focus (sr-only + focus:not-sr-only). -->
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 btn btn-primary"
    >
      Aller au contenu
    </a>

    <Header />

    <!-- flex-1 : le main prend toute la hauteur disponible,
         ce qui pousse le footer en bas même sur une page courte. -->
    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
