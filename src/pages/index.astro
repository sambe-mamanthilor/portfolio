---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
---

<Layout title="Maman Thilor SAMBE">
  <div class="bg-gradient-to-br from-sky-50 to-cyan-50">

<section id="hero" class="relative min-h-screen overflow-hidden pt-36">

  <!-- Background -->
  <div
    class="absolute inset-0 bg-cover bg-center"
    style="background-image:url('/images/banner.jpg')"
  ></div>

  <!-- Overlay sombre -->
  <div class="absolute inset-0 bg-slate-950/70"></div>

  <!-- Dégradé -->
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-900/75 to-cyan-950/60"></div>

  <!-- Halo -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-cyan-400/20 rounded-full blur-[150px]"></div>

  <div class="container-custom relative z-10 min-h-screen flex items-center">

    <div class="grid lg:grid-cols-2 gap-16 items-center w-full">

      <!-- TEXTE -->

      <div>

        <span class="inline-flex items-center px-5 py-2 rounded-full bg-cyan-500/20 border border-cyan-300/30 text-cyan-200 text-sm font-medium mb-8">
          BTS SIO option SLAM • Recherche d'alternance
        </span>

        <h1 class="text-4xl lg:text-7xl font-bold text-white leading-tight mb-6">
          Maman Thilor
          <span class="block text-cyan-300">
            SAMBE
          </span>
        </h1>

        <p class="text-xl lg:text-2xl text-cyan-100 font-semibold mb-6">
          Développeuse full stack en devenir
        </p>

        <p class="text-lg text-slate-300 leading-relaxed max-w-2xl mb-10">
          Étudiante en BTS Services Informatiques aux Organisations option SLAM à INGETIS Paris, je conçois et développe des applications web modernes en combinant développement, UX/UI et gestion de projet.
        </p>

        <div class="flex flex-wrap gap-4">

          <a
            href="#projects"
            class="px-8 py-4 rounded-full bg-cyan-500 text-white font-semibold hover:bg-cyan-600 transition"
          >
            Voir mes projets
          </a>

          <a
            href="/contact"
            class="px-8 py-4 rounded-full border border-white/30 bg-white/10 backdrop-blur text-white font-semibold hover:bg-white/20 transition"
          >
            Me contacter
          </a>

        </div>

        <div class="mt-10">

          <a
            href="https://www.linkedin.com/in/maman-thilor-sambe-996592389/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-cyan-300 hover:text-white transition font-medium"
          >
            LinkedIn →
          </a>

        </div>

      </div>

      <!-- PHOTO -->

      <div class="flex justify-center lg:justify-end">

        <div class="relative">

          <div class="absolute -inset-6 bg-cyan-400/30 rounded-full blur-3xl"></div>

          
          <div class="flex justify-center lg:justify-end">

  <img
    src="/images/moi.jpeg"
    alt="Maman Thilor Sambe"
    class="relative z-10 w-[320px] h-[320px] lg:w-[420px] lg:h-[420px] rounded-full object-cover border-4 border-cyan-300/30 shadow-2xl"
/>

</div>

        </div>

      </div>

    </div>

  </div>

</section>
<section
  id="about"
  class="section-padding bg-slate-950 relative overflow-hidden"
>

  <!-- Halo -->

  <div class="absolute top-0 left-0 w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px]"></div>

  <div class="container-custom relative z-10">

    <!-- Titre -->

    <div class="max-w-4xl mb-16">

      <span class="text-cyan-400 font-semibold uppercase tracking-[0.2em]">
        À propos
      </span>

      <h2
        class="text-2xl sm:text-3xl font-bold text-white mt-4 mb-6"
        style="font-family: 'Playfair Display', serif;"
      >
        Un parcours entre créativité et développement
      </h2>

      <p class="text-xl text-slate-300 leading-relaxed">
        Mon parcours en Métiers du Multimédia et de l'Internet m'a permis
        d'acquérir une vision globale des projets numériques. Aujourd'hui,
        je poursuis ma spécialisation en BTS SIO option SLAM afin de renforcer
        mes compétences en développement d'applications web et participer à
        des projets concrets au sein d'une équipe technique.
      </p>

    </div>

    <!-- Cartes -->

    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6">

      <div class="bg-slate-900 border border-cyan-400 rounded-3xl p-6 hover:border-cyan-500/40 transition-all">

        <h3 class="text-white font-bold text-lg mb-2">
          Formation
        </h3>

        <p class="text-slate-400">
          Une année en MMI → BTS SIO SLAM
        </p>
      </div>

      <div class="bg-slate-900 border border-cyan-400 rounded-3xl p-6 hover:border-cyan-500/40 transition-all">

        <h3 class="text-white font-bold text-lg mb-2">
          Spécialité
        </h3>

        <p class="text-slate-400">
          Développement full stack & UX/UI design
        </p>
      </div>

      <div class="bg-slate-900 border border-cyan-400 rounded-3xl p-6 hover:border-cyan-500/40 transition-all">

        <h3 class="text-white font-bold text-lg mb-2">
          Triple compétence
        </h3>

        <p class="text-slate-400">
          UX/UI design, Communication digitale & Développement
        </p>
      </div>

      <div class="bg-slate-900 border border-cyan-400 rounded-3xl p-6 hover:border-cyan-500/40 transition-all">

        <h3 class="text-white font-bold text-lg mb-2">
          Objectif
        </h3>

        <p class="text-slate-400">
          Trouver une alternance en parallèle avec mon BTS SIO.
        </p>
      </div>

    </div>

   

    </div>

  </div>

</section>

   
{/* COMPÉTENCES */}

<section
  id="competences"
  class="relative overflow-hidden py-32"
>

  <!-- Background aquarelle -->

  <div
    class="absolute inset-0"
    style="
      background-image:url('/images/bg-watercolor.png');
      background-size:cover;
      background-position:center;
      background-repeat:no-repeat;
    "
  ></div>

  <!-- Voile blanc -->

  <div class="absolute inset-0 bg-white/40"></div>

  <div class="container-custom relative z-10">

    <!-- TITRE -->

    <div class="text-center mb-20">

      <h2
        class="text-4xl sm:text-4xl font-bold mb-6 text-slate-900"
        style="font-family:'Playfair Display', serif;"
      >
        Mon écosystème numérique
      </h2>

      <div class="h-1 w-24 mx-auto bg-gradient-to-r from-cyan-400 to-sky-500 rounded-full mb-6"></div>

      <p class="text-xl text-slate-700 max-w-4xl mx-auto">
        Les technologies et outils que j'utilise pour concevoir,
        développer, déployer et valoriser des projets numériques.
      </p>

    </div>

    <!-- IMAGE COMPÉTENCES -->

    <div class="max-w-5xl mx-auto mb-14">

      <div
        class="
          bg-white/85
          backdrop-blur-md
          rounded-[40px]
          shadow-2xl
          border
          border-white/60
          p-8 md:p-10
        "
      >

        <img
          src="/images/competences-techniques.png"
          alt="Compétences techniques"
          class="w-full h-auto object-contain"
        />

      </div>

    </div>

   <!-- SOFT SKILLS -->

<div class="text-center mt-12">

  <h3 class="text-2xl font-bold text-slate-900 mb-8">
    Soft Skills
  </h3>

  <div class="flex flex-wrap justify-center gap-4">

    <span class="px-6 py-3 rounded-full  bg-cyan-200 text-cyan border border-cyan-600 text-slate-800 font-semibold shadow-md hover:shadow-xl hover:-translate-y-1 transition-all">
      Organisée et rigoureuse
    </span>

    <span class="px-6 py-3 rounded-full  bg-cyan-200 text-cyan border border-cyan-600 text-slate-800 font-semibold shadow-md hover:shadow-xl hover:-translate-y-1 transition-all">
      Persévérante
    </span>

    <span class="px-6 py-3 rounded-full  bg-cyan-200 text-cyan border border-cyan-600 text-slate-800 font-semibold shadow-md hover:shadow-xl hover:-translate-y-1 transition-all">
      Sens du relationnel
    </span>

    <span class="px-6 py-3 rounded-full  bg-cyan-200 text-cyan border border-cyan-600 text-slate-800 font-semibold shadow-md hover:shadow-xl hover:-translate-y-1 transition-all">
      Créative
    </span>

    <span class="px-6 py-3 rounded-full  bg-cyan-200 text-cyan border border-cyan-600 text-slate-800 font-semibold shadow-md hover:shadow-xl hover:-translate-y-1 transition-all">
      Curieuse
    </span>

  </div>

</div>

</section>

   <Projects />

   {/* PARCOURS */}

<section
  id="formation"
  class="relative overflow-hidden py-32"
>

  <!-- Background aquarelle -->

  <div
    class="absolute inset-0"
    style="
      background-image:url('/images/bg-watercolor.png');
      background-size:cover;
      background-position:center;
      background-repeat:no-repeat;
    "
  ></div>

  <!-- Voile -->

  <div class="absolute inset-0 bg-white/40"></div>

  <div class="container-custom relative z-10">

    <!-- Titre -->

    <div class="text-center mb-16">

      <h2
        class="text-4xl sm:text-5xl font-bold mb-4 text-slate-900"
        style="font-family:'Playfair Display', serif;"
      >
        Mon parcours
      </h2>

      <div class="h-1 w-24 mx-auto bg-gradient-to-r from-sky-400 to-cyan-400 rounded-full mb-6"></div>

      <p class="text-xl text-slate-700 max-w-4xl mx-auto leading-relaxed">
        De la création de contenus numériques au développement d'applications,
        mon parcours reflète une évolution progressive vers les métiers du développement logiciel.
        Aujourd'hui, je poursuis cette trajectoire à travers le BTS SIO SLAM afin de renforcer
        mes compétences techniques et construire des solutions utiles et innovantes.
      </p>

    </div>

    <!-- Cartes -->

    <div class="max-w-5xl mx-auto space-y-8">

      <!-- BUT MMI -->

      <div
        class="
          bg-white/90
          backdrop-blur-md
          border
          border-white/60
          shadow-xl
          rounded-[40px]
          p-8
          flex
          flex-col
          md:flex-row
          items-center
          gap-8
        "
      >

        <img
          src="/images/mmi.png"
          alt="MMI"
          class="w-28 h-28 object-contain flex-shrink-0"
        />

        <div class="flex-1">

          <h3 class="text-2xl font-bold text-slate-900 mb-3">
            BUT Métiers du Multimédia et de l'Internet
          </h3>

          <p class="text-slate-600 leading-relaxed mb-4">
            Formation en développement web, communication digitale,
            UX/UI design et production audiovisuelle à travers
            des projets concrets et des mises en situation professionnelles.
          </p>

          <span class="inline-flex px-4 py-2 rounded-full bg-cyan-100 text-cyan-700 font-semibold">
            IUT Nord Franche-Comté • 2025 – 2026
          </span>

        </div>

      </div>

      <!-- BTS -->

      <div
        class="
          bg-white/90
          backdrop-blur-md
          border
          border-white/60
          shadow-xl
          rounded-[40px]
          p-8
          flex
          flex-col
          md:flex-row
          items-center
          gap-8
        "
      >

        <img
          src="/images/ingetis.webp"
          alt="Ingetis"
          class="w-28 h-28 object-contain flex-shrink-0"
        />

        <div class="flex-1">

          <h3 class="text-2xl font-bold text-slate-900 mb-3">
            BTS SIO option SLAM
          </h3>

          <p class="text-slate-600 leading-relaxed mb-4">
            Formation orientée développement logiciel,
            bases de données, programmation orientée objet,
            architecture applicative et cybersécurité.
          </p>

          <span class="inline-flex px-4 py-2 rounded-full bg-cyan-100 text-cyan-700 font-semibold">
            INGETIS Paris • 2026 – 2028
          </span>

        </div>

      </div>

    </div>

    <!-- Bouton -->

    <div class="text-center mt-14">

      <a
        href="/parcours"
        class="
          inline-flex
          items-center
          px-8
          py-4
          rounded-full
          bg-gradient-to-r
          from-cyan-500
          to-sky-600
          text-white
          font-semibold
          shadow-lg
          hover:shadow-xl
          hover:scale-105
          transition-all
        "
      >
        Découvrir mon parcours →
      </a>

    </div>

  </div>

</section>
   

{/* EXPERIENCES */}

<section
  id="experiences"
  class="relative overflow-hidden py-32 bg-slate-950"
>

  <!-- Background code -->

 <div
  class="absolute inset-0"
  style="
    background-image:url('/images/code-bg.jpg');
    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
  "
></div>

  <!-- Grille -->

  <div
    class="absolute inset-0 opacity-10"
    style="
      background-image:
      linear-gradient(rgba(34,211,238,.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(34,211,238,.08) 1px, transparent 1px);
      background-size:60px 60px;
    "
  ></div>

  <!-- Overlay -->

<div class="absolute inset-0 bg-slate-950/60"></div>
  <div class="container-custom relative z-10">

    <div class="text-center mb-16">

      <h2
        class="text-4xl sm:text-5xl font-bold mb-4 text-white"
        style="font-family:'Playfair Display', serif;"
      >
        Expériences professionnelles
      </h2>

      <div class="h-1 w-24 mx-auto bg-gradient-to-r from-cyan-400 to-sky-500 rounded-full mb-6"></div>

      <p class="text-xl text-slate-300 max-w-3xl mx-auto">
        Des expériences qui ont renforcé mon sens de l'organisation,
        ma rigueur professionnelle et ma capacité d'adaptation.
      </p>

    </div>

    <div class="grid lg:grid-cols-2 gap-8">

      <!-- LOUM -->

      <article
        class="
          group
          bg-slate-900/90
          backdrop-blur-md
          border
          border-cyan-500/20
          rounded-[32px]
          shadow-2xl
          p-8
          transition-all
          duration-500
          hover:-translate-y-2
          hover:border-cyan-400/50
          hover:shadow-cyan-500/20
        "
      >

        <div class="flex flex-col items-center text-center mb-8">

          <img
            src="/images/loum.png"
            alt="Loum Consulting"
            class="w-28 h-28 object-contain mb-6"
          />

          <h3 class="text-3xl font-bold text-white mb-2">
            Loum Consulting
          </h3>

          <p class="text-cyan-300 font-semibold text-lg">
            Stage administratif & bureautique
          </p>

        </div>

        <p class="text-slate-300 leading-relaxed mb-8">
          Durant cette expérience, j'ai participé à la gestion documentaire,
          au classement des dossiers ainsi qu'à l'organisation des informations administratives.
          Cette mission m'a permis de développer une méthode de travail rigoureuse,
          une meilleure maîtrise des outils bureautiques et un sens accru de l'organisation.
        </p>

        <div class="mb-8 p-6 rounded-2xl bg-slate-800/60 border border-slate-700">

          <p class="italic text-slate-300 leading-relaxed">
            « Tout au long de la formation, elle a fait preuve d'un esprit vif, d'une excellente capacité de compréhension et d'une grande facilité d'apprentissage. Elle assimilait rapidement les notions abordées et veillait toujours à maîtriser parfaitement chaque compétence avant la fin de chaque séance. Son sérieux, sa motivation et sa volonté de bien faire lui permettront sans aucun doute de réussir dans ses futures missions professionnelles. »
          </p>

          <p class="mt-4 font-semibold text-cyan-300">
            — Directrice de Loum Consulting
          </p>

        </div>

        <div class="flex flex-wrap gap-3">

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Organisation
          </span>

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Bureautique
          </span>

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Gestion documentaire
          </span>

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Rigueur
          </span>

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Autonomie
          </span>

        </div>

      </article>

           <!-- PROCO -->

      <article
        class="
          group
          bg-slate-900/90
          backdrop-blur-md
          border
          border-cyan-500/20
          rounded-[32px]
          shadow-2xl
          p-8
          transition-all
          duration-500
          hover:-translate-y-2
          hover:border-cyan-400/50
          hover:shadow-cyan-500/20
        "
      >

        <div class="flex flex-col items-center text-center mb-8">

          <img
            src="/images/proco.png"
            alt="Proco Confection"
            class="w-28 h-28 object-contain mb-6"
          />

          <h3 class="text-3xl font-bold text-white mb-2">
            Proco Confection
          </h3>

          <p class="text-cyan-300 font-semibold text-lg">
            Stage en environnement de production
          </p>

        </div>

        <p class="text-slate-300 leading-relaxed mb-8">
          Cette expérience m'a permis de participer à différentes étapes
          de la chaîne de production : étiquetage, emballage, contrôle qualité
          et préparation des produits. J'y ai développé précision,
          efficacité, sens du détail et respect des procédures.
        </p>

        <div class="mb-8 p-6 rounded-2xl bg-slate-800/60 border border-slate-700">

          <p class="italic text-slate-300 leading-relaxed">
            « Mademoiselle Sambe s'est montrée sérieuse, appliquée et impliquée
            dans les tâches qui lui ont été confiées. En cas de tâches incomprises, elle était toujours disposée à consulter ces supérieurs. Elle prenait en compte toutes mes recommandations et faisait en compte de faire le meilleur résultat. »
          </p>

          <p class="mt-4 font-semibold text-cyan-300">
            — Propriétaire de Proco Confection
          </p>

        </div>

        <div class="flex flex-wrap gap-3">

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Précision
          </span>

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Qualité
          </span>

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Travail d'équipe
          </span>

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Organisation
          </span>

          <span class="px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-sm">
            Respect des délais
          </span>

        </div>

      </article>

    </div>

  </div>

</section>

<section id="passions" class="relative overflow-hidden py-24">

<div
    class="absolute inset-0"
    style="
      background-image:url('/images/bg-watercolor.png');
      background-size:cover;
      background-position:center;
      background-repeat:no-repeat;
    "
  ></div>

  <!-- Voile -->

  <div class="absolute inset-0 bg-white/40"></div>

  <div class="container-custom relative z-10">
    <div class="text-center mb-12">

      <h2
        class="text-4xl sm:text-5xl font-bold mb-4"
        style="font-family:'Playfair Display', serif;"
      >
        Mes passions
      </h2>

      <div class="h-1 w-20 mx-auto bg-gradient-to-r from-sky-400 to-cyan-400 rounded-full"></div>
<p class="text-xl text-gray-600 max-w-4xl mx-auto">
        Au-delà des projets mutlimédias, je suis passionnée par de nombreuses choses qui enrichissent ma vie.
      </p>
    </div>

    <img
      src="/images/passion.png"
      alt="Mes passions"
      class="w-full rounded-[40px] shadow-2xl"
    />

  </div>

</section>
   
  

  </div>

</Layout>
