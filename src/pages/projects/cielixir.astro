---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Cielixir | Portfolio">

<!-- HERO -->

<section class="relative min-h-screen overflow-hidden flex items-center">

  <!-- Background -->

  <div
    class="absolute inset-0"
    style="
      background-image:url('/images/code-bg.jpg');
      background-size:cover;
      background-position:center;
    "
  ></div>

  <div class="absolute inset-0 bg-slate-950/85"></div>

  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-cyan-500/20 blur-[160px] rounded-full"></div>

  <div class="container-custom relative z-10">

    <div class="grid lg:grid-cols-2 gap-20 items-center">

      <!-- Texte -->

      <div>

        <span
          class="inline-flex px-5 py-2 rounded-full bg-cyan-500/20 border border-cyan-400/30 text-cyan-300 font-medium mb-8"
        >
          Projet phare
        </span>

        <h1
          class="text-6xl lg:text-7xl font-bold text-white mb-8"
          style="font-family:'Playfair Display', serif;"
        >
          Cielixir
        </h1>

        <p class="text-xl text-slate-300 leading-9 mb-10">

          Une plateforme web qui recommande la boisson idéale selon
          la météo, les envies et le profil utilisateur.

        </p>

        <!-- Badges -->

        <div class="flex flex-wrap gap-3 mb-10">

          <span class="skill-tag">Astro</span>

          <span class="skill-tag">Tailwind CSS</span>

          <span class="skill-tag">PocketBase</span>

          <span class="skill-tag">JavaScript</span>

          <span class="skill-tag">API Openmétéo</span>

        </div>

        <div class="flex flex-wrap gap-5">

          <a
            href="#presentation"
            class="
              px-8
              py-4
              rounded-full
              bg-gradient-to-r
              from-cyan-500
              to-sky-600
              text-white
              font-semibold
              hover:scale-105
              transition
            "
          >
            Découvrir le projet
          </a>

          <a
            href="/#projects"
            class="
              px-8
              py-4
              rounded-full
              border
              border-cyan-400/30
              bg-white/10
              backdrop-blur
              text-white
              hover:bg-white/20
              transition
            "
          >
            Retour
          </a>

        </div>

      </div>

      <!-- Capture -->

      <div class="relative">

        <div
          class="
            absolute
            -inset-4
            rounded-[40px]
            bg-cyan-500/20
            blur-3xl
          "
        ></div>

        <img
          src="/images/mockup_cielixir.png"
          alt="Cielixir"
          class="
            relative
            rounded-[36px]
            border
            border-cyan-500/20
            shadow-2xl
            hover:scale-[1.02]
            transition
            duration-500
          "
        />

      </div>

    </div>

  </div>

</section>

<div
  class="
    bg-white/90
    backdrop-blur
    rounded-[40px]
    shadow-xl
    border
    border-cyan-100
    p-8 lg:p-12
  "
>

  <div class="grid lg:grid-cols-[2fr_1fr] gap-12 items-start">

    <!-- Présentation -->

    <div>

      <h2
        class="text-3xl lg:text-4xl font-bold mb-8"
        style="font-family:'Playfair Display', serif;"
      >
        Présentation
      </h2>

      <p class="text-slate-600 text-lg leading-8 mb-6">
        Cielixir est une plateforme web développée en équipe dans le cadre de notre formation.
        Son objectif est de proposer une recommandation de boisson personnalisée selon
        plusieurs critères : la météo, les goûts de l'utilisateur et son profil.
      </p>

      <p class="text-slate-600 text-lg leading-8">
        Le projet devait offrir une expérience moderne, responsive,
        simple d'utilisation et capable de fournir des recommandations
        pertinentes grâce à une API météo.
      </p>

    </div>

    <!-- Informations -->

    <div class="space-y-8">

      <div>
        <p class="text-sm uppercase tracking-widest text-slate-400 mb-1">
          Période
        </p>

        <p class="text-xl font-bold text-slate-800">
          Avril - Mai 2026
        </p>
      </div>

      <div>
        <p class="text-sm uppercase tracking-widest text-slate-400 mb-1">
          Durée
        </p>

        <p class="text-xl font-bold text-slate-800">
          2 mois
        </p>
      </div>

      <div>
        <p class="text-sm uppercase tracking-widest text-slate-400 mb-1">
          Équipe
        </p>

        <p class="text-xl font-bold text-slate-800">
          3 étudiants
        </p>
      </div>

      <div>
        <p class="text-sm uppercase tracking-widest text-slate-400 mb-1">
          Mon rôle
        </p>

        <p class="text-l font-bold text-cyan-600">
          - Cheffe de projet
        </p>

        <p class="text-l font-bold text-cyan-600">
          - Développeuse Front-end
        </p>

        <p class="text-l font-bold text-cyan-600">
         - UX / UI Designer
        </p>

      </div>

    </div>

  </div>

</div>














<!-- MISSIONS -->

<section class="relative py-32 bg-slate-950 overflow-hidden">

  <!-- Background -->

  <div
    class="absolute inset-0"
    style="
      background-image:url('/images/code-bg.jpg');
      background-size:cover;
      background-position:center;
    "
  ></div>

  <div class="absolute inset-0 bg-slate-950/85"></div>

  <div class="container-custom relative z-10">

    <div class="text-center mb-20">

      <h2
        class="text-5xl font-bold text-white mb-6"
        style="font-family:'Playfair Display', serif;"
      >
        Mes missions
      </h2>

      <div class="w-24 h-1 bg-gradient-to-r from-cyan-400 to-sky-500 mx-auto rounded-full"></div>

    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

      <div class="bg-slate-900/90 rounded-[32px] border border-cyan-500/20 p-8 hover:-translate-y-2 transition">

        <h3 class="text-cyan-300 text-2xl font-bold mb-4">
          Gestion de projet
        </h3>

        <p class="text-slate-300 leading-8">
          Planification des tâches, organisation de l'équipe, suivi de
          l'avancement du projet et coordination grâce à Jira.
        </p>

      </div>

      <div class="bg-slate-900/90 rounded-[32px] border border-cyan-500/20 p-8 hover:-translate-y-2 transition">

        <h3 class="text-cyan-300 text-2xl font-bold mb-4">
          Développement
        </h3>

        <p class="text-slate-300 leading-8">
          Développement de plusieurs pages et composants avec Astro,
          Tailwind CSS et JavaScript.
        </p>

      </div>

      <div class="bg-slate-900/90 rounded-[32px] border border-cyan-500/20 p-8 hover:-translate-y-2 transition">

        <h3 class="text-cyan-300 text-2xl font-bold mb-4">
          UX / UI
        </h3>

        <p class="text-slate-300 leading-8">
          Conception d'une interface intuitive et amélioration de
          l'expérience utilisateur.
        </p>

      </div>

      <div class="bg-slate-900/90 rounded-[32px] border border-cyan-500/20 p-8 hover:-translate-y-2 transition">

        <h3 class="text-cyan-300 text-2xl font-bold mb-4">
          API météo
        </h3>

        <p class="text-slate-300 leading-8">
          Intégration d'une API météo afin de proposer des
          recommandations personnalisées.
        </p>

      </div>

      <div class="bg-slate-900/90 rounded-[32px] border border-cyan-500/20 p-8 hover:-translate-y-2 transition">

        <h3 class="text-cyan-300 text-2xl font-bold mb-4">
          Base de données
        </h3>

        <p class="text-slate-300 leading-8">
          Gestion des utilisateurs, des boissons et des données grâce
          à PocketBase.
        </p>

      </div>

      <div class="bg-slate-900/90 rounded-[32px] border border-cyan-500/20 p-8 hover:-translate-y-2 transition">

        <h3 class="text-cyan-300 text-2xl font-bold mb-4">
          Déploiement
        </h3>

        <p class="text-slate-300 leading-8">
          Publication du projet sur Netlify et configuration de
          l'hébergement.
        </p>

      </div>

    </div>

  </div>

</section>

<!-- TECHNOLOGIES -->

<section class="relative py-32 overflow-hidden">

  <div
    class="absolute inset-0"
    style="
      background-image:url('/images/bg-watercolor.png');
      background-size:cover;
      background-position:center;
    "
  ></div>

  <div class="absolute inset-0 bg-white/35"></div>

  <div class="container-custom relative z-10">

    <div class="grid lg:grid-cols-2 gap-10">

      <!-- Technologies -->

      <div class="bg-white/90 rounded-[40px] shadow-xl p-10">

        <h2
          class="text-4xl font-bold mb-8"
          style="font-family:'Playfair Display', serif;"
        >
          Technologies
        </h2>

        <div class="flex flex-wrap gap-4">

          <span class="skill-tag">Astro</span>

          <span class="skill-tag">Tailwind CSS</span>

          <span class="skill-tag">PocketBase</span>

          <span class="skill-tag">JavaScript</span>

          <span class="skill-tag">Openmétéo API</span>

          <span class="skill-tag">Jira</span>

          <span class="skill-tag">Netlify</span>

          <span class="skill-tag">Infomaniak</span>

        </div>

      </div>

      <!-- Compétences -->

      <div class="bg-white/90 rounded-[40px] shadow-xl p-10">

        <h2
          class="text-4xl font-bold mb-8"
          style="font-family:'Playfair Display', serif;"
        >
          Compétences mobilisées
        </h2>

        <div class="flex flex-wrap gap-4">

          <span class="skill-tag">Gestion de projet</span>

          <span class="skill-tag">Travail d'équipe</span>

          <span class="skill-tag">Communication</span>

          <span class="skill-tag">Développement web</span>

          <span class="skill-tag">UX/UI</span>

          <span class="skill-tag">Organisation</span>

          <span class="skill-tag">Résolution de problèmes</span>

          <span class="skill-tag">Méthodes Agile</span>

        </div>

      </div>

    </div>

  </div>

</section>
<!-- GALERIE -->

<section class="relative py-32 bg-slate-950 overflow-hidden">

  <!-- Background -->

  <div
    class="absolute inset-0"
    style="
      background-image:url('/images/code-bg.jpg');
      background-size:cover;
      background-position:center;
    "
  ></div>

  <div class="absolute inset-0 bg-slate-950/85"></div>

  <div class="container-custom relative z-10">

    <div class="text-center mb-20">

      <h2
        class="text-5xl font-bold text-white mb-6"
        style="font-family:'Playfair Display', serif;"
      >
        Aperçu du projet
      </h2>

      <div class="w-24 h-1 bg-gradient-to-r from-cyan-400 to-sky-500 rounded-full mx-auto mb-6"></div>

      <p class="text-slate-300 text-lg max-w-3xl mx-auto">
        Quelques captures illustrant les principales fonctionnalités et l'interface de Cielixir.
      </p>

    </div>

    <!-- Grande image -->

    <div
      class="
        overflow-hidden
        rounded-[36px]
        border
        border-cyan-500/20
        shadow-2xl
        mb-10
      "
    >

      <img
        src="/images/mockup_cielixir.png"
        alt="Accueil Cielixir"
        class="w-full hover:scale-105 transition duration-700"
      />

    </div>

   <div class="flex flex-wrap justify-center gap-6">

        <a
          href="https://cielixir.ruslanabudniak.fr/"
          class="
            px-8
            py-4
            rounded-full
            bg-gradient-to-r
            from-cyan-500
            to-sky-600
            text-white
            font-semibold
            hover:scale-105
            transition
          "
        >
          Découvrir Cielixir
        </a>
        </div>

  </div>

</section>

<!-- NAVIGATION -->

<section class="relative py-24 overflow-hidden">

  <div
    class="absolute inset-0"
    style="
      background-image:url('/images/bg-watercolor.png');
      background-size:cover;
      background-position:center;
    "
  ></div>

  <div class="absolute inset-0 bg-white/35"></div>

  <div class="container-custom relative z-10">

    <div
      class="
        bg-white/90
        backdrop-blur
        rounded-[40px]
        shadow-xl
        p-12
        text-center
      "
    >

      <h2
        class="text-4xl font-bold mb-6"
        style="font-family:'Playfair Display', serif;"
      >
        Merci pour votre visite
      </h2>

      <p class="text-slate-600 text-lg leading-8 max-w-3xl mx-auto mb-12">
        Ce projet illustre ma capacité à mener un projet en équipe,
        concevoir une interface moderne et développer une application web
        en utilisant des technologies actuelles.
      </p>

      <div class="flex flex-wrap justify-center gap-6">

        <a
          href="https://cielixir.ruslanabudniak.fr/"
          class="
            px-8
            py-4
            rounded-full
            bg-gradient-to-r
            from-cyan-500
            to-sky-600
            text-white
            font-semibold
            hover:scale-105
            transition
          "
        >
    Découvrir l'application
        </a>

        <a
          href="/projects/alice-recoque"
          class="
            px-8
            py-4
            rounded-full
            border
            border-cyan-500/20
            bg-white
            font-semibold
            hover:bg-cyan-50
            transition
          "
        >
          Projet suivant →
        </a>

      </div>

    </div>

  </div>

</section>

</Layout>