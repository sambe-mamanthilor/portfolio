---
/** Page affichée quand une adresse n'existe pas. */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable">
  <section class="zone-nuit haut-de-page pb-24 text-center" data-theme="mts-nuit" aria-labelledby="titre-page">
    <div class="container-site">
      <p class="font-display text-8xl text-primary" aria-hidden="true">404</p>
      <h1 id="titre-page" class="mt-4 font-display text-4xl">Cette page s’est perdue</h1>
      <p class="mt-4 text-lg text-muted">L’adresse demandée n’existe pas, ou plus.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-primary">Retour à l’accueil</a>
        <a href="/projets" class="btn btn-neutral border-primary/40">Voir mes projets</a>
      </div>
    </div>
  </section>
</Layout>
