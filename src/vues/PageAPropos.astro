---
/**
 * Page À propos, d'après la maquette Figma, avec le même principe que les
 * pages projet :
 *   - zone SOMBRE en haut : présentation, soft skills et langues ;
 *   - zone CLAIRE uniforme ensuite (aquarelle) : parcours, expériences,
 *     passions, séparés par la fine ligne cyan ondulée ;
 *   - entre les deux : bord en courbe douce ("bord-ondule").
 * Tout est écrit en classes utilitaires Tailwind (et daisyUI pour les boutons).
 */
import { Image } from 'astro:assets';
import { bouton } from '../lib/boutons';
import Layout from '../layouts/Layout.astro';
import LigneOndulee from '../components/LigneOndulee.astro';
import { getExperiences, fileUrl } from '../lib/pocketbase';
import { LOGOS_ECOLES, LOGOS_SECOURS } from '../lib/medias';
import { SITE } from '../data/site';
import { langue, tr, champ } from '../i18n';
import photo from '../assets/images/moi-detoure.png';
import imgTaekwondo from '../assets/images/passions/taekwondo.png';
import imgPeinture from '../assets/images/passions/peinture.png';
import imgLecture from '../assets/images/passions/lecture.png';
import imgCode from '../assets/images/passions/code.png';

const experiences = await getExperiences();

const lang = langue(Astro);

const softSkills = tr(lang,
  ['Rigoureuse', 'Travail d’équipe', 'Adaptable', 'Persévérante'],
  ['Rigorous', 'Team player', 'Adaptable', 'Persevering'],
);
const langues = [
  { nom: tr(lang, 'Français', 'French'), niveau: 'C2' },
  { nom: tr(lang, 'Anglais', 'English'), niveau: 'B1' },
  { nom: tr(lang, 'Espagnol', 'Spanish'), niveau: 'B1' },
];

const parcours = [
  {
    titre: tr(lang, 'BUT Métiers du Multimédia et de l’Internet', 'Bachelor’s degree in Multimedia & Internet (BUT MMI)'),
    periode: '2025 – 2028',
    lieu: tr(lang, 'IUT Nord Franche-Comté', 'IUT Nord Franche-Comté, France'),
    points: tr(lang, [
      'Parcours Développement web et dispositifs interactifs (2ᵉ année)',
      'Développement front-end et back-end : HTML, CSS, JavaScript, Astro, PocketBase',
      'Conception UX/UI et maquettage sur Figma',
      'Communication digitale et production audiovisuelle',
      'Gestion de projet en équipe, en méthode Agile',
    ], [
      'Web development & interactive media track (2nd year)',
      'Front-end and back-end development: HTML, CSS, JavaScript, Astro, PocketBase',
      'UX/UI design and prototyping in Figma',
      'Digital communication and video production',
      'Team project management using Agile methods',
    ]),
    tags: tr(lang, ['Création numérique', 'Développement web', 'Communication digitale'], ['Digital creation', 'Web development', 'Digital communication']),
    logo: LOGOS_ECOLES.mmi,
    altLogo: tr(lang, 'Logo du département MMI', 'MMI department logo'),
  },
  {
    titre: tr(lang, 'Baccalauréat scientifique (Sénégal)', 'Scientific baccalaureate (Senegal)'),
    periode: '2024 – 2025',
    lieu: tr(lang, 'École privée Pape Benoît XVI', 'École privée Pape Benoît XVI, Dakar'),
    points: tr(lang, [
      'Spécialités : Mathématiques, Sciences physiques, Sciences de la vie et de la Terre',
      'Une solide base en logique, en rigueur et en analyse scientifique',
    ], [
      'Majors: Mathematics, Physics and Life & Earth Sciences',
      'A solid grounding in logic, rigour and scientific analysis',
    ]),
    tags: tr(lang, ['Logique', 'Sciences'], ['Logic', 'Science']),
    logo: LOGOS_ECOLES.epb,
    altLogo: tr(lang, 'Logo de l’École privée Pape Benoît XVI', 'École privée Pape Benoît XVI logo'),
  },
];

// Expériences : même présentation que le parcours (texte à gauche, logo à droite)
const libelles: Record<string, string> = tr(lang,
  { stage: 'Stage', emploi: 'Emploi', alternance: 'Alternance', associatif: 'Engagement associatif', freelance: 'Freelance' },
  { stage: 'Internship', emploi: 'Job', alternance: 'Work-study', associatif: 'Volunteering', freelance: 'Freelance' },
);
const experiencesAffichees = experiences.map((xp) => ({
  ...xp,
  // Textes PocketBase dans la bonne langue (champ "_en" en anglais, s'il est rempli)
  poste: champ(xp, 'poste', lang),
  periode: champ(xp, 'periode', lang),
  structure: champ(xp, 'structure', lang),
  lieu: champ(xp, 'lieu', lang),
  description: champ(xp, 'description', lang),
  // Pour une association, le nom dit déjà « Association… » : on n'affiche que le nom
  libelle: xp.type === 'associatif' ? '' : (libelles[xp.type] ?? ''),
  logoDistant: fileUrl(xp, xp.logo),
  logoLocal: LOGOS_SECOURS[xp.structure.split(' ')[0].toLowerCase()],
  altLogo: xp.logo_alt || `Logo ${xp.structure}`,
}));

const passions = [
  { titre: 'Taekwondo', image: imgTaekwondo, texte: tr(lang,
    'Cultiver la discipline, la persévérance et le dépassement de soi à travers une pratique exigeante.',
    'Building discipline, perseverance and self-improvement through a demanding sport.') },
  { titre: tr(lang, 'Art & peinture', 'Art & painting'), image: imgPeinture, texte: tr(lang,
    'Développer mon sens de l’observation, de l’esthétique et de la composition à travers l’expression artistique.',
    'Sharpening my sense of observation, aesthetics and composition through artistic expression.') },
  { titre: tr(lang, 'Lecture', 'Reading'), image: imgLecture, texte: tr(lang,
    'Nourrir ma curiosité, enrichir ma réflexion et découvrir de nouvelles perspectives à travers les livres.',
    'Feeding my curiosity, deepening my thinking and discovering new perspectives through books.') },
  { titre: tr(lang, 'Création numérique', 'Digital creation'), image: imgCode, texte: tr(lang,
    'Transformer des idées en projets concrets en associant design, technologie et innovation.',
    'Turning ideas into real projects by combining design, technology and innovation.') },
];

// Classes communes aux pastilles (parcours) et aux logos ronds
const pastille = 'rounded-full border border-primary/60 px-3.5 py-1 text-sm font-semibold';
// Cadre autour de chaque formation / expérience (maquette Figma : trait cyan fin de 1 px)
// Cadre d'une ligne du parcours / d'une expérience.
// Même forme partout ; seul le fond change selon la zone :
// voile blanc sur la zone claire, voile très léger sur la zone sombre.
const cadreBase = 'flex flex-col-reverse gap-6 border border-[#79f4ff] p-6 md:flex-row md:items-center md:justify-between md:p-8';
const cadre = `${cadreBase} bg-white/50`;
const cadreNuit = `${cadreBase} bg-white/5`;
const logoRond = 'size-24 flex-none rounded-full border border-base-300 bg-white object-contain p-2 md:size-28';
---

<Layout
  title={tr(lang, 'À propos', 'About')}
  description={tr(lang,
    'Parcours, expériences et passions de Maman Thilor SAMBE, étudiante en BUT MMI spécialisée en développement web et UX/UI.',
    'Education, experience and interests of Maman Thilor SAMBE, BUT MMI student specialising in web development and UX/UI.')}
>
  <!-- ===================== ZONE SOMBRE : PRÉSENTATION ===================== -->
  <div data-theme="mts-nuit" class="bg-linear-to-b from-[#0a0f2e] to-[#111a3d] text-base-content">
    <section class="haut-de-page pb-24" aria-labelledby="titre-page">
      <div class="container-site grid items-center gap-12 md:grid-cols-[1fr_auto] md:gap-16">
        <div>
          <h1 id="titre-page" class="font-display text-5xl">{tr(lang, 'À propos', 'About me')}</h1>
          <div class="mt-8 max-w-2xl space-y-4 text-lg leading-relaxed text-muted">
            <p>
              {tr(lang,
                'Étudiante en 2ᵉ année de BUT MMI à l’IUT Nord Franche-Comté, parcours développement web et dispositifs interactifs, je conçois des sites et applications web de bout en bout : de l’analyse des besoins et du design UX/UI jusqu’au développement et à la mise en ligne.',
                'I’m a second-year student in a Bachelor’s degree in Multimedia & Internet (BUT MMI) at IUT Nord Franche-Comté, France, specialising in web development and interactive media. I design and build websites and web apps end to end: from needs analysis and UX/UI design to development and launch.')}
            </p>
            <p>
              {tr(lang,
                'Rigoureuse, curieuse et autonome, j’aime quand un code propre sert une expérience soignée. Je recherche une alternance dès janvier 2027 ou un stage dès fin mars 2027 en développement web.',
                'Rigorous, curious and independent, I love it when clean code serves a polished experience. I’m looking for a work-study position from January 2027 or an internship from late March 2027 in web development.')}
            </p>
          </div>
        </div>

        <!-- Photo : même design que sur la couverture de l'accueil (ovale, bordure
             cyan, halo dessous), à la taille de cette page. La photo détourée est
             descendue de 10 % pour que la tête tienne entière dans l'ovale. -->
        <div
          class="relative mx-auto aspect-[420/453] w-60 overflow-hidden rounded-[50%] border-3 border-primary/25
                 shadow-[4px_0_4px_rgb(121_244_255/0.38),0_30px_30px_rgb(121_244_255/0.39)] md:w-80"
        >
          <Image
            src={photo}
            alt={tr(lang, 'Portrait de Maman Thilor Sambe, souriante, portant un voile bleu marine', 'Portrait of Maman Thilor Sambe, smiling, wearing a navy blue headscarf')}
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 320px, 240px"
            loading="eager"
            class="absolute top-[10%] left-1/2 h-auto w-[98%] max-w-none -translate-x-1/2"
          />
        </div>
      </div>

      <!-- Soft skills et langues -->
      <div class="container-site mt-16 grid gap-10 sm:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-light">Soft skills</h2>
          <ul class="mt-5 space-y-3 font-semibold">
            {softSkills.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="font-display text-3xl font-light">{tr(lang, 'Mes langues', 'Languages')}</h2>
          <ul class="mt-5 space-y-3 font-semibold">
            {langues.map((l) => <li>{l.nom} <span class="text-primary">{l.niveau}</span></li>)}
          </ul>
        </div>
      </div>
    </section>
  </div>

  <!-- Rythme de la page : sombre (présentation) → clair (parcours)
       → SOMBRE (expériences) → clair (passions) → sombre (pied de page).
       L'alternance évite un long défilement tout clair et met en valeur
       les expériences. Chaque zone commence par un bord ondulé + ligne cyan. -->

  <!-- ===================== ZONE CLAIRE : PARCOURS ===================== -->
  <div data-theme="mts" class="bord-ondule bg-page bg-(image:--fond-aquarelle) bg-cover bg-top text-base-content">
    <LigneOndulee superpose />

    <!-- ============ PARCOURS ============ -->
    <section id="parcours" class="section scroll-mt-28" aria-labelledby="titre-parcours">
      <div class="container-site">
        <h2 id="titre-parcours" class="titre-section">{tr(lang, 'Mon parcours', 'Education')}</h2>
        <ol class="mt-12 space-y-8">
          {parcours.map((p) => (
            <li class={cadre}>
              <div class="w-full max-w-3xl">
                <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
                  <h3 class="text-xl font-bold md:text-2xl">{p.titre}</h3>
                  <p class="font-semibold text-primary italic">{p.periode}</p>
                </div>
                <p class="mt-1 text-sm font-semibold text-accent">{p.lieu}</p>
                <!-- Une ligne par point ; marker:text-primary colore la puce en cyan -->
                <ul class="mt-4 list-disc space-y-1.5 pl-5 text-lg text-muted marker:text-primary">
                  {p.points.map((pt) => <li>{pt}</li>)}
                </ul>
                <ul class="mt-5 flex flex-wrap gap-3" aria-label={tr(lang, 'Domaines', 'Fields')}>
                  {p.tags.map((t) => <li class={pastille}>{t}</li>)}
                </ul>
              </div>
              <Image src={p.logo} alt={p.altLogo} width={128} height={128} class={logoRond} />
            </li>
          ))}
        </ol>
      </div>
    </section>

  </div>

  <!-- ===================== ZONE SOMBRE : EXPÉRIENCES ===================== -->
  <!-- data-theme="mts-nuit" : toutes les couleurs (texte, cyan, gris) passent
       automatiquement en version « nuit », sans changer les classes. -->
  {experiencesAffichees.length > 0 && (
    <div data-theme="mts-nuit" class="bord-ondule zone-nuit text-base-content">
      <LigneOndulee superpose />
      <section id="experiences" class="section scroll-mt-28" aria-labelledby="titre-xp">
        <div class="container-site">
          <h2 id="titre-xp" class="titre-section">{tr(lang, 'Mes expériences', 'Experience')}</h2>
          <ol class="mt-12 space-y-8">
            {experiencesAffichees.map((xp) => (
              <li class={cadreNuit}>
                <div class="w-full max-w-3xl">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
                    <h3 class="text-xl font-bold md:text-2xl">{xp.poste}</h3>
                    <p class="font-semibold text-primary italic">{xp.periode}</p>
                  </div>
                  <p class="mt-1 text-sm font-semibold text-accent">
                    {xp.libelle && `${xp.libelle} · `}{xp.structure}{xp.lieu && ` · ${xp.lieu}`}
                  </p>
                  <!-- Puces en petits losanges, uniquement pour les expériences :
                       [&_ul]:list-['◆'] = « pour les ul à l'intérieur, la puce est un losange » ;
                       [&_li]:marker:text-xs = losange plus petit ; [&_li]:ps-2 = espace après le losange -->
                  <div
                    class="texte-riche mt-4 text-lg text-muted [&_li]:ps-2 [&_li]:marker:text-xs [&_p+ul]:mt-3 [&_ul]:list-['◆']"
                    set:html={xp.description}
                  />
                </div>
                {xp.logoDistant ? (
                  <img src={xp.logoDistant} alt={xp.altLogo} width="112" height="112" loading="lazy" class={logoRond} />
                ) : xp.logoLocal ? (
                  <Image src={xp.logoLocal} alt={xp.altLogo} width={112} height={112} class={logoRond} />
                ) : (
                  <span class:list={[logoRond, 'grid place-items-center font-display text-2xl text-[#0a0f2e]']} aria-hidden="true">
                    {xp.structure.slice(0, 2)}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </div>
      </section>
    </div>
  )}

  <!-- ===================== ZONE CLAIRE : PASSIONS ===================== -->
  <div data-theme="mts" class="bord-ondule bg-page bg-(image:--fond-aquarelle) bg-cover bg-top text-base-content">
    <LigneOndulee superpose />
    <section id="passions" class="section scroll-mt-28" aria-labelledby="titre-passions">
      <div class="container-site">
        <h2 id="titre-passions" class="titre-section">{tr(lang, 'Mes passions', 'Interests')}</h2>
        <!-- Panneaux qui s'ouvrent (ordinateur) :
             - au repos, le 1er panneau est ouvert et les autres fermés ;
             - au survol (ou au clavier avec Tab), le panneau visé s'ouvre
               (flex-[3] = il prend 3 fois plus de place) et les autres se referment.
             - [ul:not(:hover,:focus-within)>&:first-child] : variante "sur mesure"
               qui veut dire « je suis le 1er panneau ET personne ne survole la liste ».
             - le texte est replié avec max-h-0 (hauteur 0) pour que le titre reste en bas.
             Sur mobile : tout est ouvert, empilé, sans animation. -->
        <ul class="mt-12 flex flex-col gap-4 md:h-[18rem] md:flex-row">
          {passions.map((p) => (
            <li
              tabindex="0"
              class="group relative flex flex-col justify-end overflow-hidden rounded-box border border-base-300 bg-white/70 p-6
                     outline-primary transition-[flex-grow,border-color,background-color] duration-500 ease-out
                     motion-reduce:transition-none md:flex-1
                     md:hover:flex-[3] md:hover:border-primary md:hover:bg-white
                     md:focus-visible:flex-[3] md:focus-visible:border-primary md:focus-visible:bg-white
                     md:[ul:not(:hover,:focus-within)>&:first-child]:flex-[3]
                     md:[ul:not(:hover,:focus-within)>&:first-child]:border-primary
                     md:[ul:not(:hover,:focus-within)>&:first-child]:bg-white"
            >
              <!-- Illustration (maquette Figma). mb-auto la pousse en haut du panneau ;
                   alt="" car elle est décorative : le titre dit déjà de quoi il s'agit. -->
              <Image
                src={p.image}
                alt=""
                height={128}
                class="relative mb-auto h-24 w-auto self-start object-contain transition-transform duration-500
                       motion-reduce:transition-none md:h-32 md:group-hover:scale-110 md:group-focus-visible:scale-110"
              />
              <!-- Trait cyan qui s'allonge quand le panneau s'ouvre -->
              <span
                aria-hidden="true"
                class="mb-4 block h-1 w-8 rounded-full bg-primary transition-[width] duration-500
                       md:group-hover:w-16 md:group-focus-visible:w-16
                       md:[ul:not(:hover,:focus-within)>li:first-child_&]:w-16"
              ></span>
              <h3 class="relative font-display text-2xl">{p.titre}</h3>
              <p
                class="relative max-w-md overflow-hidden text-muted transition-[max-height,opacity,margin] duration-500
                       mt-2 md:mt-0 md:max-h-0 md:opacity-0
                       md:group-hover:mt-2 md:group-hover:max-h-40 md:group-hover:opacity-100
                       md:group-focus-visible:mt-2 md:group-focus-visible:max-h-40 md:group-focus-visible:opacity-100
                       md:[ul:not(:hover,:focus-within)>li:first-child_&]:mt-2
                       md:[ul:not(:hover,:focus-within)>li:first-child_&]:max-h-40
                       md:[ul:not(:hover,:focus-within)>li:first-child_&]:opacity-100"
              >
                {p.texte}
              </p>
            </li>
          ))}
        </ul>

        <div class="mt-14 text-center">
          <a href={SITE.cv} class={bouton('principal')} download>
            {tr(lang, 'Télécharger mon CV', 'Download my CV')}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14" /></svg>
            <span class="sr-only">(PDF)</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
